{
box-sizing: border-box;
}

:root {
--primary: #2563eb;
--primary-dark: #1d4ed8;
--primary-soft: #eff6ff;

--green: #16a34a;
--green-soft: #f0fdf4;

--red: #dc2626;
--red-soft: #fef2f2;

--orange: #ea580c;

--bg: #f5f7fb;
--panel: #ffffff;

--text: #172033;
--muted: #64748b;
--border: #e5e7eb;

--radius: 14px;


}

html,
body {
margin: 0;
min-height: 100%;
}

body {
font-family:
Inter,
-apple-system,
BlinkMacSystemFont,
"Segoe UI",
Roboto,
Arial,
sans-serif;

background: var(--bg);
color: var(--text);


}

/* =========================================================
HEADER
========================================================= */

.pos-header {
height: 72px;

display: flex;
align-items: center;
justify-content: space-between;

padding: 0 26px;

background: #ffffff;

border-bottom: 1px solid var(--border);

position: sticky;
top: 0;

z-index: 20;


}

.brand-area {
display: flex;
align-items: center;
gap: 11px;

min-width: 220px;


}

.brand-logo {
width: 38px;
height: 38px;

display: grid;
place-items: center;

border-radius: 10px;

background: var(--primary);

color: white;

font-size: 19px;
font-weight: 800;


}

.brand-text {
display: flex;
flex-direction: column;
gap: 1px;
}

.brand-text strong {
font-size: 15px;
}

.brand-text span {
font-size: 11px;
color: var(--muted);
}

.header-center {
flex: 1;

display: flex;
justify-content: center;


}

.location-display {
display: flex;
align-items: center;
gap: 8px;

color: #475569;

font-size: 13px;
font-weight: 600;


}

.location-icon {
color: var(--primary);
font-size: 10px;
}

.header-actions {
display: flex;
align-items: center;
gap: 12px;

min-width: 300px;
justify-content: flex-end;


}

.cashier-display {
display: flex;
align-items: center;
gap: 9px;
}

.cashier-avatar {
width: 34px;
height: 34px;

display: grid;
place-items: center;

border-radius: 50%;

background: #eef2ff;
color: #4338ca;

font-weight: 800;
font-size: 13px;


}

.cashier-display div:last-child {
display: flex;
flex-direction: column;
gap: 2px;
}

.cashier-display strong {
font-size: 12px;
}

.register-status {
font-size: 11px;
color: var(--green);
font-weight: 700;
}

.header-btn {
border: 0;
background: transparent;

padding: 8px 10px;

border-radius: 8px;

cursor: pointer;

font-size: 12px;
font-weight: 700;


}

.close-register-btn {
color: #475569;
}

.close-register-btn:hover {
background: #f1f5f9;
}

.logout-btn {
color: var(--red);
}

.logout-btn:hover {
background: var(--red-soft);
}

/* =========================================================
MAIN WORKSPACE
========================================================= */

.pos-workspace {
max-width: 1600px;

margin: 0 auto;

display: grid;

grid-template-columns:
    minmax(0, 1fr)
    410px;

gap: 22px;

padding: 24px;


}

/* =========================================================
CATALOG
========================================================= */

.catalog-section {
min-width: 0;
}

.catalog-heading {
margin-bottom: 18px;
}

.section-eyebrow {
font-size: 10px;

letter-spacing: 0.12em;

font-weight: 800;

color: var(--primary);

margin-bottom: 5px;


}

.catalog-heading h1 {
margin: 0;

font-size: 25px;

letter-spacing: -0.025em;


}

.catalog-heading p {
margin: 6px 0 0;

color: var(--muted);

font-size: 13px;


}

/* =========================================================
SEARCH
========================================================= */

.product-search {
height: 50px;

display: flex;
align-items: center;

background: white;

border: 1px solid var(--border);

border-radius: 11px;

padding: 0 13px;

box-shadow:
    0 1px 2px rgba(15, 23, 42, 0.03);


}

.product-search:focus-within {
border-color: #93c5fd;

box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.08);


}

.search-icon {
color: #94a3b8;

font-size: 24px;

margin-right: 8px;


}

.product-search input {
flex: 1;

height: 100%;

border: 0;
outline: 0;

font-size: 14px;

color: var(--text);

background: transparent;


}

.search-shortcut {
font-size: 9px;

font-weight: 800;

letter-spacing: 0.08em;

color: #94a3b8;

padding: 5px 7px;

background: #f8fafc;

border-radius: 5px;


}

/* =========================================================
PRODUCT GRID
========================================================= */

.products-grid {
display: grid;

grid-template-columns:
    repeat(auto-fill, minmax(205px, 1fr));

gap: 13px;

margin-top: 18px;


}

.product-card {
background: white;

border: 1px solid var(--border);

border-radius: 12px;

padding: 15px;

min-height: 190px;

display: flex;
flex-direction: column;

transition:
    border-color 0.15s,
    box-shadow 0.15s,
    transform 0.15s;


}

.product-card:hover {
border-color: #bfdbfe;

box-shadow:
    0 8px 22px rgba(15, 23, 42, 0.07);

transform: translateY(-1px);


}

.product-card.out-of-stock {
opacity: 0.65;
}

.product-name {
font-weight: 750;

font-size: 14px;

line-height: 1.35;

min-height: 38px;


}

.product-sku {
font-size: 11px;

color: var(--muted);

margin-top: 3px;


}

.product-price {
font-size: 19px;

font-weight: 800;

margin-top: 14px;

color: var(--text);


}

.product-stock {
margin-top: 3px;

color: var(--green);

font-size: 11px;

font-weight: 650;


}

.product-stock.out {
color: var(--red);
}

.product-card select {
width: 100%;

margin-top: auto;

padding: 7px 8px;

border:
    1px solid var(--border);

border-radius: 7px;

background: #fafafa;

font-size: 11px;


}

.product-card button {
width: 100%;

margin-top: 8px;

padding: 9px;

border: 0;

border-radius: 7px;

background: var(--primary);

color: white;

font-size: 11px;

font-weight: 750;

cursor: pointer;


}

.product-card button:hover {
background: var(--primary-dark);
}

.product-card button:disabled {
background: #e2e8f0;

color: #94a3b8;

cursor: not-allowed;


}

.other-locations-toggle {
background: none;

border: 0;

padding: 0;

margin-top: 5px;

color: #7c3aed;

font-size: 10px;

cursor: pointer;

text-align: left;


}

.other-locations-list {
margin-top: 5px;

padding: 7px;

border-radius: 7px;

background: #f8fafc;

color: #475569;

font-size: 10px;


}

.other-locations-list div {
display: flex;
justify-content: space-between;

padding: 2px 0;


}

/* =========================================================
SALE PANEL
========================================================= */

.sale-panel {
background: white;

border: 1px solid var(--border);

border-radius: 15px;

padding: 19px;

position: sticky;

top: 94px;

height: calc(100vh - 118px);

min-height: 620px;

display: flex;
flex-direction: column;

box-shadow:
    0 5px 20px rgba(15, 23, 42, 0.04);


}

.sale-panel-header {
display: flex;

justify-content: space-between;

align-items: flex-start;

padding-bottom: 14px;

border-bottom: 1px solid var(--border);


}

.sale-panel-header h2 {
margin: 0;

font-size: 18px;


}

.cart-count {
color: var(--muted);

font-size: 11px;

font-weight: 700;


}

/* =========================================================
CART
========================================================= */

.cart-items {
flex: 1;

overflow-y: auto;

padding: 8px 0;

min-height: 120px;


}

.cart-item {
display: flex;

gap: 9px;

padding: 11px 0;

border-bottom: 1px solid #f1f5f9;


}

.cart-item-info {
flex: 1;

min-width: 0;


}

.cart-item-name {
font-size: 12px;

font-weight: 700;

line-height: 1.35;


}

.cart-item-price {
font-size: 11px;

color: var(--muted);

margin-top: 3px;


}

.cart-item-qty-controls {
display: flex;

align-items: center;

gap: 5px;


}

.cart-item-qty-controls button {
width: 25px;
height: 25px;

border:
    1px solid var(--border);

background: white;

border-radius: 6px;

cursor: pointer;

font-weight: 700;


}

.cart-item-qty-controls button:hover {
background: #f8fafc;
}

.cart-item-remove {
border: 0;

background: none;

color: var(--red);

font-size: 10px;

cursor: pointer;


}

.empty-cart {
height: 100%;

min-height: 150px;

display: flex;

flex-direction: column;

align-items: center;

justify-content: center;

text-align: center;

color: var(--muted);


}

.empty-cart-icon {
width: 40px;
height: 40px;

display: grid;
place-items: center;

border-radius: 50%;

background: #f1f5f9;

color: #94a3b8;

font-size: 22px;

margin-bottom: 10px;


}

.empty-cart strong {
color: var(--text);

font-size: 12px;


}

.empty-cart p {
margin: 4px 0 0;

max-width: 190px;

font-size: 11px;

line-height: 1.5;


}

/* =========================================================
SUMMARY
========================================================= */

.sale-details {
border-top: 1px solid var(--border);

padding-top: 10px;


}

.summary-row {
display: flex;

align-items: center;

justify-content: space-between;

padding: 5px 0;

font-size: 12px;


}

.summary-row span {
color: var(--muted);
}

.summary-row strong {
color: var(--text);
}

.tax-row label {
margin: 0;

font-size: 12px;

color: var(--muted);


}

.tax-input-wrapper {
display: flex;

align-items: center;

gap: 4px;

color: var(--muted);


}

.tax-input-wrapper input {
width: 58px;

padding: 5px 6px;

text-align: right;

border:
    1px solid var(--border);

border-radius: 6px;

outline: none;


}

/* =========================================================
TOTAL
========================================================= */

.sale-total {
display: flex;

justify-content: space-between;

align-items: center;

margin-top: 8px;

padding: 14px 0;

border-top: 1px solid var(--border);


}

.sale-total span {
font-size: 13px;

font-weight: 750;


}

.sale-total strong {
font-size: 25px;

letter-spacing: -0.03em;

color: var(--primary);


}

/* =========================================================
CHECKOUT DETAILS
========================================================= */

.checkout-details {
display: grid;

gap: 4px;


}

.checkout-details label {
margin-top: 7px;

font-size: 10px;

font-weight: 800;

color: #64748b;

text-transform: uppercase;

letter-spacing: 0.04em;


}

.checkout-details input,
.checkout-details select {
width: 100%;

height: 38px;

padding: 0 10px;

border:
    1px solid var(--border);

border-radius: 7px;

background: #fff;

outline: none;

font-size: 12px;


}

.checkout-details input:focus,
.checkout-details select:focus {
border-color: #93c5fd;

box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.07);


}

.change-row {
display: flex;

justify-content: space-between;

align-items: center;

padding: 8px 0 0;

font-size: 11px;

color: var(--muted);


}

.change-row strong {
color: var(--green);

font-size: 13px;


}

/* =========================================================
CHECKOUT BUTTON
========================================================= */

.checkout-btn {
width: 100%;

display: flex;

align-items: center;

justify-content: space-between;

margin-top: 15px;

padding: 13px 15px;

border: 0;

border-radius: 9px;

background: var(--primary);

color: white;

font-size: 13px;

font-weight: 800;

cursor: pointer;


}

.checkout-btn:hover:not(:disabled) {
background: var(--primary-dark);
}

.checkout-btn:disabled {
background: #cbd5e1;

color: #f8fafc;

cursor: not-allowed;


}

.checkout-arrow {
font-size: 17px;
}

/* =========================================================
ERROR
========================================================= */

.error-banner {
background: var(--red-soft);

color: #b91c1c;

border-bottom:
    1px solid #fecaca;

padding: 10px 20px;

font-size: 12px;

font-weight: 600;


}

/* =========================================================
REGISTER MODAL
========================================================= */

.modal-overlay {
position: fixed;

inset: 0;

display: grid;

place-items: center;

padding: 20px;

background:
    rgba(15, 23, 42, 0.58);

z-index: 100;


}

.register-modal {
width: min(100%, 400px);

background: white;

border-radius: 17px;

padding: 28px;

box-shadow:
    0 25px 70px rgba(15, 23, 42, 0.25);


}

.register-modal-icon {
width: 48px;
height: 48px;

display: grid;

place-items: center;

border-radius: 12px;

background: var(--primary-soft);

color: var(--primary);

font-size: 21px;

font-weight: 800;

margin-bottom: 18px;


}

.register-modal h2 {
margin: 0;

font-size: 22px;


}

.register-modal p {
margin: 7px 0 20px;

color: var(--muted);

font-size: 12px;

line-height: 1.6;


}

.register-modal label {
display: block;

margin-bottom: 6px;

font-size: 11px;

font-weight: 800;

color: #475569;

text-transform: uppercase;


}

.money-input {
height: 46px;

display: flex;

align-items: center;

gap: 9px;

padding: 0 12px;

border:
    1px solid var(--border);

border-radius: 9px;


}

.money-input span {
color: var(--muted);

font-weight: 700;


}

.money-input input {
flex: 1;

border: 0;

outline: 0;

font-size: 17px;

font-weight: 700;


}

.modal-primary-btn {
width: 100%;

margin-top: 16px;

padding: 12px;

border: 0;

border-radius: 9px;

background: var(--primary);

color: white;

font-weight: 800;

cursor: pointer;


}

.modal-primary-btn:hover {
background: var(--primary-dark);
}

.modal-error {
margin-top: 10px;

padding: 9px;

border-radius: 7px;

background: var(--red-soft);

color: var(--red);

font-size: 11px;


}

/* =========================================================
RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

.pos-workspace {
    grid-template-columns:
        minmax(0, 1fr)
        360px;
}

.header-center {
    display: none;
}


}

@media (max-width: 850px) {

.pos-header {
    height: auto;

    min-height: 72px;

    padding: 12px 16px;

    gap: 12px;

    flex-wrap: wrap;
}

.header-actions {
    min-width: auto;

    margin-left: auto;
}

.cashier-display {
    display: none;
}

.pos-workspace {
    grid-template-columns: 1fr;

    padding: 16px;
}

.sale-panel {
    position: relative;

    top: auto;

    height: auto;

    min-height: 500px;
}


}

@media (max-width: 520px) {

.brand-text {
    display: none;
}

.products-grid {
    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 8px;
}

.product-card {
    padding: 11px;
}

.product-price {
    font-size: 16px;
}

.search-shortcut {
    display: none;
}


}