* {
    box-sizing: border-box;
}

:root {
    --bg: #f5f7fb;
    --surface: #ffffff;
    --surface-soft: #f8fafc;
    --border: #e5e7eb;
    --border-dark: #d1d5db;
    --text: #111827;
    --muted: #6b7280;
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --success: #16a34a;
    --danger: #dc2626;
    --warning: #d97706;
    --shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
}

html,
body {
    margin: 0;
    min-height: 100%;
}

body {
    font-family:
        Inter,
        ui-sans-serif,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

    background: var(--bg);
    color: var(--text);
}

button,
input,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

[hidden] {
    display: none !important;
}


/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 28px;

    background: var(--surface);
    border-bottom: 1px solid var(--border);

    position: sticky;
    top: 0;
    z-index: 20;
}

.brand-area {
    display: flex;
    align-items: center;
    gap: 11px;
}

.brand-mark {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background: #2563eb;
    color: white;

    font-size: 18px;
    font-weight: 800;
}

.brand-name {
    font-size: 15px;
    font-weight: 800;
    line-height: 1.2;
}

.brand-subtitle {
    margin-top: 2px;
    color: var(--muted);
    font-size: 11px;
}

.topbar-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
}

.location-pill {
    display: flex;
    align-items: center;
    gap: 8px;

    padding: 7px 12px;

    border: 1px solid var(--border);
    border-radius: 999px;

    background: var(--surface-soft);

    color: #374151;
    font-size: 12px;
    font-weight: 600;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 18px;
}

.cashier-info {
    display: flex;
    align-items: center;
    gap: 9px;
}

.cashier-avatar {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #eff6ff;
    color: var(--primary);

    font-size: 13px;
    font-weight: 800;
}

.cashier-name {
    font-size: 12px;
    font-weight: 700;
}

.register-status {
    margin-top: 2px;
    color: var(--success);
    font-size: 11px;
}

.topbar-action {
    border: 0;
    background: transparent;

    color: #475569;

    font-size: 12px;
    font-weight: 700;
}

.topbar-action:hover {
    color: var(--primary);
}

.logout-action {
    color: #64748b;
}


/* =========================================================
   ERROR
   ========================================================= */

.error-banner {
    margin: 14px 24px 0;
    padding: 12px 15px;

    border: 1px solid #fecaca;
    border-radius: 10px;

    background: #fef2f2;
    color: #b91c1c;

    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   MAIN WORKSPACE
   ========================================================= */

.pos-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 410px;

    gap: 20px;

    max-width: 1700px;
    margin: 0 auto;

    padding: 24px;
}

.catalog-panel {
    min-width: 0;
}

.catalog-header {
    margin-bottom: 20px;
}

.eyebrow {
    margin: 0 0 5px;

    color: #64748b;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 0.14em;
}

.catalog-header h1 {
    margin: 0;

    font-size: 25px;
    letter-spacing: -0.03em;
}

.catalog-description {
    margin: 6px 0 0;

    color: var(--muted);
    font-size: 13px;
}


/* =========================================================
   SEARCH
   ========================================================= */

.search-box {
    display: flex;
    align-items: center;

    height: 52px;

    padding: 0 13px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 12px;

    box-shadow: 0 3px 12px rgba(15, 23, 42, 0.035);
}

.search-icon {
    margin-right: 10px;

    color: #94a3b8;

    font-size: 24px;
    line-height: 1;
}

.search-box input {
    flex: 1;

    min-width: 0;

    border: 0;
    outline: 0;

    background: transparent;

    color: var(--text);

    font-size: 14px;
}

.search-box input::placeholder {
    color: #94a3b8;
}

.search-shortcut {
    padding: 5px 8px;

    border: 1px solid var(--border);
    border-radius: 6px;

    color: #94a3b8;

    font-size: 10px;
}


/* =========================================================
   PRODUCT GRID
   ========================================================= */

.products-grid {
    display: grid;

    grid-template-columns:
        repeat(auto-fill, minmax(190px, 1fr));

    gap: 13px;

    margin-top: 18px;
}

.product-card {
    min-height: 190px;

    display: flex;
    flex-direction: column;

    padding: 15px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 13px;

    transition:
        transform 0.12s ease,
        border-color 0.12s ease,
        box-shadow 0.12s ease;
}

.product-card:hover {
    transform: translateY(-2px);

    border-color: #bfdbfe;

    box-shadow: var(--shadow);
}

.product-card.out-of-stock {
    opacity: 0.65;
}

.product-name {
    color: var(--text);

    font-size: 14px;
    font-weight: 750;

    line-height: 1.35;
}

.product-sku {
    margin-top: 4px;

    color: #94a3b8;

    font-size: 10px;
}

.product-price {
    margin-top: auto;
    padding-top: 16px;

    color: var(--text);

    font-size: 18px;
    font-weight: 800;
}

.product-stock {
    margin-top: 4px;

    color: var(--success);

    font-size: 11px;
    font-weight: 600;
}

.product-stock.out {
    color: var(--danger);
}

.product-card select {
    width: 100%;

    margin-top: 9px;
    padding: 7px 8px;

    border: 1px solid var(--border);
    border-radius: 7px;

    background: white;

    font-size: 11px;
}

.product-card button {
    width: 100%;

    margin-top: 9px;
    padding: 9px;

    border: 0;
    border-radius: 8px;

    background: var(--primary);
    color: white;

    font-size: 12px;
    font-weight: 700;
}

.product-card button:hover:not(:disabled) {
    background: var(--primary-dark);
}

.product-card button:disabled {
    background: #e2e8f0;
    color: #94a3b8;

    cursor: not-allowed;
}

.other-locations-toggle {
    margin-top: 5px;

    padding: 0;

    border: 0;
    background: transparent;

    color: #7c3aed;

    font-size: 10px;
    text-align: left;
}

.other-locations-list {
    margin-top: 5px;
    padding: 7px 8px;

    border-radius: 7px;

    background: #f8fafc;

    color: #64748b;

    font-size: 10px;
}

.other-locations-list div {
    display: flex;
    justify-content: space-between;
}


/* =========================================================
   CHECKOUT PANEL
   ========================================================= */

.checkout-panel {
    position: sticky;
    top: 92px;

    min-height: calc(100vh - 116px);

    display: flex;
    flex-direction: column;

    padding: 20px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 16px;

    box-shadow: var(--shadow);
}

.checkout-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    padding-bottom: 15px;

    border-bottom: 1px solid var(--border);
}

.checkout-header h2 {
    margin: 0;

    font-size: 19px;
    letter-spacing: -0.02em;
}

.cart-badge {
    padding: 6px 9px;

    border-radius: 7px;

    background: #f1f5f9;

    color: #64748b;

    font-size: 10px;
    font-weight: 700;
}

.cart-badge span {
    color: var(--text);
}


/* =========================================================
   CART
   ========================================================= */

.cart-items {
    flex: 1;

    min-height: 130px;
    max-height: 330px;

    overflow-y: auto;

    padding: 4px 0;
}

.empty-cart {
    min-height: 180px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    color: #64748b;
}

.empty-cart-icon {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    margin-bottom: 10px;

    border-radius: 12px;

    background: #eff6ff;
    color: var(--primary);

    font-size: 25px;
}

.empty-cart strong {
    color: #334155;
    font-size: 13px;
}

.empty-cart span {
    max-width: 190px;

    margin-top: 4px;

    font-size: 11px;
    line-height: 1.4;
}

.cart-item {
    display: flex;
    align-items: center;

    gap: 8px;

    padding: 11px 0;

    border-bottom: 1px solid #f1f5f9;
}

.cart-item-info {
    flex: 1;
    min-width: 0;
}

.cart-item-name {
    overflow: hidden;

    color: #1e293b;

    font-size: 12px;
    font-weight: 700;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.cart-item-qty-controls {
    display: flex;
    align-items: center;
    gap: 4px;
}

.cart-item-qty-controls button {
    width: 24px;
    height: 24px;

    padding: 0;

    border: 1px solid var(--border);
    border-radius: 6px;

    background: white;

    color: #475569;

    font-size: 13px;
}

.cart-item-qty-controls button:hover {
    border-color: #93c5fd;
    color: var(--primary);
}

.cart-item-remove {
    padding: 3px;

    border: 0;
    background: transparent;

    color: #ef4444;

    font-size: 11px;
}


/* =========================================================
   SUMMARY
   ========================================================= */

.sale-summary {
    padding: 14px 0;

    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}

.summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 4px 0;

    color: #64748b;

    font-size: 12px;
}

.summary-row strong {
    color: #334155;
    font-weight: 700;
}

.tax-row {
    align-items: center;
}

.tax-input-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
}

.tax-input-wrap input {
    width: 55px;

    padding: 5px;

    border: 1px solid var(--border);
    border-radius: 6px;

    text-align: right;

    font-size: 11px;
}

.tax-input-wrap span {
    color: #94a3b8;
    font-size: 11px;
}

.grand-total {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 9px;
    padding-top: 12px;

    border-top: 1px dashed var(--border-dark);
}

.grand-total span {
    color: var(--text);

    font-size: 13px;
    font-weight: 750;
}

.grand-total strong {
    color: var(--primary);

    font-size: 23px;
    font-weight: 850;
    letter-spacing: -0.03em;
}


/* =========================================================
   CHECKOUT FIELDS
   ========================================================= */

.checkout-fields {
    padding-top: 13px;
}

.field-group {
    margin-bottom: 10px;
}

.field-group label,
.modal-field label {
    display: block;

    margin-bottom: 5px;

    color: #475569;

    font-size: 10px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.field-group input,
.field-group select {
    width: 100%;

    height: 38px;

    padding: 0 10px;

    border: 1px solid var(--border);
    border-radius: 8px;

    outline: none;

    background: white;

    color: #1e293b;

    font-size: 12px;
}

.field-group input:focus,
.field-group select:focus {
    border-color: #93c5fd;

    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.change-display {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin: 4px 0 10px;
    padding: 9px 10px;

    border-radius: 8px;

    background: #f0fdf4;

    color: #166534;

    font-size: 11px;
    font-weight: 650;
}

.change-display strong {
    font-size: 14px;
}


/* =========================================================
   CHECKOUT BUTTON
   ========================================================= */

.checkout-btn {
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-top: auto;
    padding: 13px 15px;

    border: 0;
    border-radius: 10px;

    background: var(--primary);
    color: white;

    font-size: 13px;
    font-weight: 800;

    box-shadow: 0 7px 15px rgba(37, 99, 235, 0.18);
}

.checkout-btn:hover:not(:disabled) {
    background: var(--primary-dark);
}

.checkout-btn:disabled {
    background: #cbd5e1;
    color: #f8fafc;

    box-shadow: none;

    cursor: not-allowed;
}

.checkout-arrow {
    font-size: 17px;
}


/* =========================================================
   MODALS
   ========================================================= */

.modal-overlay {
    position: fixed;
    inset: 0;

    display: grid;
    place-items: center;

    padding: 20px;

    background: rgba(15, 23, 42, 0.62);

    backdrop-filter: blur(5px);

    z-index: 100;
}

.register-modal {
    width: min(100%, 430px);

    padding: 28px;

    background: white;

    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 18px;

    box-shadow:
        0 25px 70px rgba(15, 23, 42, 0.25),
        0 5px 15px rgba(15, 23, 42, 0.08);
}

.modal-icon {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    margin-bottom: 18px;

    border-radius: 13px;

    font-size: 21px;
    font-weight: 850;
}

.open-icon {
    background: #eff6ff;
    color: var(--primary);
}

.close-icon {
    background: #f0fdf4;
    color: var(--success);
}

.modal-heading h2 {
    margin: 0;

    font-size: 23px;
    letter-spacing: -0.03em;
}

.modal-heading p:last-child {
    margin: 7px 0 22px;

    color: #64748b;

    font-size: 12px;
    line-height: 1.55;
}

.modal-field {
    margin-top: 16px;
}

.money-input {
    display: flex;
    align-items: center;

    height: 50px;

    padding: 0 14px;

    border: 1px solid var(--border-dark);
    border-radius: 10px;

    background: #fff;
}

.money-input:focus-within {
    border-color: #60a5fa;

    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
}

.money-input > span {
    color: #64748b;

    font-size: 17px;
    font-weight: 750;
}

.money-input input {
    width: 100%;

    padding: 0 0 0 8px;

    border: 0;
    outline: 0;

    background: transparent;

    color: var(--text);

    font-size: 19px;
    font-weight: 750;
}

.primary-modal-btn,
.danger-modal-btn,
.secondary-modal-btn {
    height: 45px;

    border-radius: 9px;

    font-size: 12px;
    font-weight: 800;
}

.primary-modal-btn {
    width: 100%;

    margin-top: 22px;

    border: 0;

    background: var(--primary);
    color: white;
}

.primary-modal-btn:hover {
    background: var(--primary-dark);
}

.cash-reconciliation {
    margin-top: 10px;
    padding: 14px;

    border-radius: 11px;

    background: #f8fafc;
}

.reconciliation-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    color: #64748b;

    font-size: 12px;
}

.reconciliation-row strong {
    color: var(--text);

    font-size: 16px;
}

.reconciliation-divider {
    height: 1px;

    margin: 13px 0;

    background: var(--border);
}

.modal-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 9px;

    margin-top: 20px;
}

.secondary-modal-btn {
    border: 1px solid var(--border-dark);

    background: white;
    color: #475569;
}

.secondary-modal-btn:hover {
    background: #f8fafc;
}

.danger-modal-btn {
    border: 0;

    background: var(--danger);
    color: white;
}

.danger-modal-btn:hover {
    background: #b91c1c;
}

.modal-error {
    margin-top: 13px;
    padding: 9px 11px;

    border: 1px solid #fecaca;
    border-radius: 8px;

    background: #fef2f2;
    color: #b91c1c;

    font-size: 11px;
    font-weight: 600;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1050px) {

    .pos-workspace {
        grid-template-columns: minmax(0, 1fr) 350px;
    }

    .topbar-center {
        display: none;
    }

}

@media (max-width: 820px) {

    .topbar {
        height: auto;
        min-height: 68px;

        padding: 12px 16px;
    }

    .cashier-info {
        display: none;
    }

    .pos-workspace {
        grid-template-columns: 1fr;

        padding: 16px;
    }

    .checkout-panel {
        position: relative;
        top: auto;

        min-height: auto;
    }

    .cart-items {
        max-height: 260px;
    }

}

@media (max-width: 520px) {

    .brand-subtitle {
        display: none;
    }

    .topbar-right {
        gap: 10px;
    }

    .topbar-action {
        font-size: 11px;
    }

    .products-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .catalog-header h1 {
        font-size: 21px;
    }

    .register-modal {
        padding: 22px;
    }

}
