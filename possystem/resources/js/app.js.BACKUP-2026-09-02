const state = {
    token: localStorage.getItem('pos_token') || '',
    user: null,
    products: [],
    locations: {},
    cart: [],
    paymentMethod: 'cash',
    search: '',
    sessionOpen: false,
    sessionLocationId: 1,
    currentSession: null,
    lastCloseSummary: null,
    viewAllSales: false,
    sales: [],
    salesSummary: {
        total_sales: 0,
        total_amount: 0,
        voided_sales: 0,
    },
    reportRangeFrom: new Date().toISOString().slice(0, 10),
    reportRangeTo: new Date().toISOString().slice(0, 10),
    report: {
        meta: {
            total_sales: 0,
            total_amount: 0,
            payment_summary: {},
        },
        data: [],
    },
    notice: null,
    customerName: '',
    openingCash: '',
    closingCash: '',
    receivedAmount: '',
    paymentReference: '',
    taxRate: '',
    lastReceipt: null,
};
state.customerName = '';
let productSearchTimer = null;

const app = document.getElementById('app');

function formatCurrency(value) {
    return new Intl.NumberFormat('en-PH', {
        style: 'currency',
        currency: 'PHP',
    }).format(Number(value || 0));
}

function getSessionStock(product) {
    return Number(product.stock_quantity || 0);
}

async function loadLocations() {
    try {
        const response = await fetch('/api/pos/locations', {
            headers: getAuthHeaders(),
        });
        if (!response.ok) return;

        const result = await response.json();
        state.sessionLocationId = Number(result.configured_location_id || state.sessionLocationId);
        state.locations = Object.fromEntries(
            (result.data || []).map((location) => [
                Number(location.id),
                `${location.name || `Location ${location.id}`}${location.code ? ` (${location.code})` : ''}`,
            ]),
        );
    } catch (error) {
        state.locations = {};
    }
}

async function viewReceiptFor(saleId) {
    const response = await fetch(`/api/sales/${saleId}/receipt`, {
        headers: getAuthHeaders(),
    });

    const result = await response.json();
    if (!response.ok) {
        setNotice(result.message || 'Unable to load the receipt.', 'error');
        return;
    }

    const receipt = result.data;
    const payment = receipt.payments?.[0];
    state.lastReceipt = {
        id: receipt.id,
        sale_number: receipt.sale_number,
        customer_name: receipt.customer_name || 'Walk-in Customer',
        payment_method: payment?.method || 'cash',
        subtotal: Number(receipt.subtotal || 0),
        discount_total: Number(receipt.discount || 0),
        tax_total: Number(receipt.tax || 0),
        total: Number(receipt.total || 0),
        received_amount: null,
        change: null,
        items: receipt.items || [],
    };
    setNotice(`Loaded receipt ${receipt.sale_number}.`, 'success');
    renderDashboard();
}

function getAuthHeaders() {
    return {
        'Content-Type': 'application/json',
        Accept: 'application/json',
        ...(state.token ? { Authorization: `Bearer ${state.token}` } : {}),
    };
}

function setNotice(message, variant = 'info') {
    state.notice = { message, variant };
    const notice = document.getElementById('notice');
    if (!notice) return;

    notice.className = `rounded-lg border px-3 py-2 text-sm ${
        variant === 'error'
            ? 'border-red-200 bg-red-50 text-red-700'
            : variant === 'success'
                ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                : 'border-sky-200 bg-sky-50 text-sky-700'
    }`;
    notice.textContent = message;
}

function renderLogin() {
    app.innerHTML = `
        <div class="flex min-h-screen items-center justify-center">
            <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-xl ring-1 ring-slate-200">
                <div class="mb-6 text-center">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">POS</p>
                    <h1 class="mt-2 text-3xl font-bold text-slate-900">Shogun Retail</h1>
                </div>

                <div id="notice" class="mb-4 hidden"></div>

                <form id="loginForm" class="space-y-4">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Email</label>
                        <input name="email" type="email" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 outline-none ring-0 transition focus:border-sky-500" placeholder="cashier@example.com" required />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700">Password</label>
                        <input name="password" type="password" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 outline-none ring-0 transition focus:border-sky-500" placeholder="••••••••" required />
                    </div>
                    <button type="submit" class="w-full rounded-xl bg-sky-600 px-4 py-3 font-semibold text-white transition hover:bg-sky-700">Login</button>
                </form>
            </div>
        </div>
    `;

    const loginForm = document.getElementById('loginForm');
    loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const formData = new FormData(loginForm);
        const payload = {
            email: formData.get('email'),
            password: formData.get('password'),
        };

        try {
            const response = await fetch('/api/login', {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify(payload),
            });

            const result = await response.json();

            if (!response.ok) {
                setNotice(result.message || 'Login failed.', 'error');
                return;
            }

            state.token = result.token;
            localStorage.setItem('pos_token', state.token);
            setNotice('Login successful. Opening cashier dashboard…', 'success');
            await loadDashboard();
        } catch (error) {
            setNotice('Unable to reach POS API.', 'error');
        }
    });
}

async function loadCurrentSession() {
    try {
        const response = await fetch('/api/cash-sessions/current', {
            headers: getAuthHeaders(),
        });

        if (!response.ok) {
            state.currentSession = null;
            state.sessionOpen = false;
            return;
        }

        const result = await response.json();
        state.currentSession = result.data || null;
        state.sessionOpen = Boolean(state.currentSession);
        state.sessionLocationId = state.currentSession?.location_id || state.sessionLocationId;
    } catch (error) {
        state.currentSession = null;
        state.sessionOpen = false;
    }
}

async function openCashSession() {
    const openingCash = document.getElementById('openingCash')?.value || state.openingCash || 0;
    state.openingCash = openingCash;

    const response = await fetch('/api/cash-sessions/open', {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({ opening_cash: Number(openingCash) }),
    });

    const result = await response.json();

    if (!response.ok) {
        setNotice(result.message || 'Unable to open cash session.', 'error');
        return false;
    }

    state.sessionOpen = true;
    state.lastCloseSummary = null;
    await loadCurrentSession();
    setNotice('Cash session opened successfully.', 'success');
    return true;
}

async function closeCashSession() {
    const closingCash = document.getElementById('closingCash')?.value || state.closingCash || 0;

    const response = await fetch('/api/cash-sessions/close', {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({ closing_cash: Number(closingCash) }),
    });

    const result = await response.json();

    if (!response.ok) {
        setNotice(result.message || 'Unable to close cash session.', 'error');
        return false;
    }

    state.sessionOpen = false;
    state.currentSession = null;
    state.cart = [];
    state.customerName = '';
    state.openingCash = '';
    state.closingCash = '';
    state.receivedAmount = '';
    state.paymentReference = '';
    state.lastCloseSummary = result.data || null;
    setNotice(`Cash session closed. Variance: ${formatCurrency(result.data?.variance || 0)}`, 'success');
    return true;
}

async function loadDashboard() {
    try {
        const userResponse = await fetch('/api/user', { headers: getAuthHeaders() });
        if (!userResponse.ok) {
            state.token = '';
            localStorage.removeItem('pos_token');
            renderLogin();
            return;
        }

        state.user = await userResponse.json();
        await loadCurrentSession();
        await loadLocations();
        await loadProducts();
        await loadSales();
        await loadSalesSummary();
        await loadSalesReport();
        renderDashboard();
    } catch (error) {
        setNotice('Unable to load the dashboard.', 'error');
    }
}

async function loadProducts(search = '') {
    const params = new URLSearchParams();
    if (search) params.append('search', search);
    params.append('location_id', String(state.sessionLocationId));

    const response = await fetch(`/api/pos/products?${params.toString()}`, {
        headers: getAuthHeaders(),
    });

    if (!response.ok) {
        setNotice('Unable to load products.', 'error');
        return;
    }

    const result = await response.json();
    state.products = result.data || [];

    state.products.forEach((product) => {
        (product.inventories || []).forEach((inventory) => {
            const locationId = Number(inventory.location_id);
            if (!locationId || state.locations[locationId]) return;

            state.locations[locationId] =
                inventory.location_name ||
                inventory.location_code ||
                `Location ${locationId}`;
        });
    });
}

function locationOptions() {
    const locations = Object.entries(state.locations);
    if (!locations.length) {
        return `<option value="${state.sessionLocationId}">Location ${state.sessionLocationId}</option>`;
    }

    return locations
        .map(([id, label]) => `<option value="${id}" ${Number(id) === Number(state.sessionLocationId) ? 'selected' : ''}>${label}</option>`)
        .join('');
}

async function loadSales() {
    try {
        const response = await fetch('/api/sales', { headers: getAuthHeaders() });
        if (!response.ok) {
            return;
        }

        const result = await response.json();
        state.sales = result.data || [];
    } catch (error) {
        state.sales = [];
    }
}

async function loadSalesSummary() {
    try {
        const params = new URLSearchParams();
        if (state.user?.role === 'manager' && state.viewAllSales) {
            params.append('all', '1');
        }

        const response = await fetch(`/api/sales/summary?${params.toString()}`, {
            headers: getAuthHeaders(),
        });
        if (!response.ok) {
            return;
        }

        const result = await response.json();
        state.salesSummary = result.meta || {
            total_sales: 0,
            total_amount: 0,
            voided_sales: 0,
        };
    } catch (error) {
        state.salesSummary = {
            total_sales: 0,
            total_amount: 0,
            voided_sales: 0,
        };
    }
}

async function loadSalesReport() {
    try {
        const params = new URLSearchParams();
        if (state.reportRangeFrom) params.append('from', state.reportRangeFrom);
        if (state.reportRangeTo) params.append('to', state.reportRangeTo);
        if (state.user?.role === 'manager' && state.viewAllSales) {
            params.append('all', '1');
        }

        const response = await fetch(`/api/sales/report?${params.toString()}`, {
            headers: getAuthHeaders(),
        });

        if (!response.ok) {
            state.report = {
                meta: {
                    total_sales: 0,
                    total_amount: 0,
                    payment_summary: {},
                },
                data: [],
            };
            return;
        }

        const result = await response.json();
        state.report = result || {
            meta: {
                total_sales: 0,
                total_amount: 0,
                payment_summary: {},
            },
            data: [],
        };
    } catch (error) {
        state.report = {
            meta: {
                total_sales: 0,
                total_amount: 0,
                payment_summary: {},
            },
            data: [],
        };
    }
}

async function lookupByCode(code) {
    const params = new URLSearchParams({ code, location_id: String(state.sessionLocationId) });

    const response = await fetch(`/api/pos/products/lookup?${params.toString()}`, {
        headers: getAuthHeaders(),
    });

    const result = await response.json();

    if (!response.ok) {
        setNotice(result.message || `No product found for "${code}".`, 'error');
        return null;
    }

    return result.data;
}

async function voidSale(saleId) {
    const reason = window.prompt('Reason for voiding this sale (optional):', '') || '';

    const response = await fetch(`/api/sales/${saleId}/void`, {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({ reason }),
    });

    const result = await response.json();

    if (!response.ok) {
        setNotice(result.message || 'Unable to void this sale.', 'error');
        return;
    }

    const restockedCount = (result.restocked || []).length;
    setNotice(`Sale ${result.data?.sale_number || ''} voided. ${restockedCount} item(s) restocked.`, 'success');

    await loadSales();
    await loadSalesSummary();
    renderDashboard();
}

async function refundSale(saleId) {
    const reason = window.prompt('Reason for refunding this sale (optional):', '') || '';
    const response = await fetch(`/api/sales/${saleId}/refund`, {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({ reason }),
    });
    const result = await response.json();

    if (!response.ok) {
        setNotice(result.message || 'Unable to refund this sale.', 'error');
        return;
    }

    setNotice(`Sale ${result.data?.sale_number || ''} refunded and inventory restocked.`, 'success');
    await loadSales();
    await loadSalesSummary();
    renderDashboard();
}

async function printReceiptFor(saleId) {
    const response = await fetch(`/api/sales/${saleId}/receipt/print`, {
        headers: getAuthHeaders(),
    });

    if (!response.ok) {
        setNotice('Unable to load the printable receipt.', 'error');
        return;
    }

    const text = await response.text();
    const printWindow = window.open('', '_blank');

    if (!printWindow) {
        setNotice('Your browser blocked the receipt window.', 'error');
        return;
    }

    printWindow.document.write(`<!doctype html><html><head><title>Receipt</title></head><body style="font-family:monospace;white-space:pre-wrap;padding:24px;">${text}</body></html>`);
    printWindow.document.close();
    printWindow.focus();
    printWindow.print();
}

function addToCart(product) {
    const availableStock = getSessionStock(product);
    if (availableStock <= 0) {
        setNotice(`"${product.name}" is out of stock.`, 'error');
        return;
    }

    const item = state.cart.find((entry) => entry.id === product.id);

    if (item) {
        if (item.quantity >= item.stock_quantity) {
            setNotice(`Only ${item.stock_quantity} unit(s) of "${item.name}" are available.`, 'error');
            return;
        }
        item.quantity += 1;
        renderDashboard();
        return;
    }

    const defaultUnit = product.units?.find((unit) => unit.is_default) || product.units?.[0];

    state.cart.push({
        id: product.id,
        name: product.name,
        sku: product.sku,
        unit_price: Number(product.selling_price || product.price || 0),
        quantity: 1,
        product_unit_id: defaultUnit?.id || 1,
        location_id: state.sessionLocationId,
        discount: 0,
        stock_quantity: Number(product.stock_quantity || 0),
    });

    renderDashboard();
}

function updateCartItem(id, changes) {
    state.cart = state.cart.map((item) => {
        if (item.id !== id) return item;
        return {
            ...item,
            ...changes,
            quantity: Math.min(Number(changes.quantity ?? item.quantity), item.stock_quantity),
        };
    }).filter((item) => item.quantity > 0);

    renderDashboard();
}

function getCartSummary() {
    const subtotal = state.cart.reduce((sum, item) => sum + item.unit_price * item.quantity, 0);
    const discount = state.cart.reduce((sum, item) => sum + Number(item.discount || 0) * item.quantity, 0);
    const total = subtotal - discount;
    return { subtotal, discount, total };
}

function cashPreview(total) {
    const received = Number(state.receivedAmount || 0);
    if (!state.receivedAmount) return 'Enter cash received to calculate change.';
    const change = received - total;
    return change >= 0
        ? `Change for customer: ${formatCurrency(change)}`
        : `Remaining balance: ${formatCurrency(Math.abs(change))}`;
}

