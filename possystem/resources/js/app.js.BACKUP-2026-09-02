                            <p class="mt-1 text-xs">Opening cash: ${formatCurrency(state.currentSession?.opening_cash || 0)} · Expected cash: ${formatCurrency(state.currentSession?.expected_cash || 0)}</p>
                        ` : `
                            <p class="font-semibold">No open cash session</p>
                            <p class="mt-1 text-xs">Open the register before ringing up sales.</p>
                        `}
                        ${state.lastCloseSummary ? `
                            <p class="mt-2 border-t border-current/20 pt-2 text-xs">
                                Last close — expected ${formatCurrency(state.lastCloseSummary.expected_cash)},
                                actual ${formatCurrency(state.lastCloseSummary.actual_cash)},
                                variance <span class="font-semibold">${formatCurrency(state.lastCloseSummary.variance)}</span>
                            </p>
                        ` : ''}
                    </div>

                    <div class="space-y-3">
                        <div class="grid grid-cols-2 gap-2">
                            <label class="text-sm font-medium text-slate-700">
                                Opening cash
                                <input id="openingCash" type="number" min="0" step="0.01" value="${state.openingCash}" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500 disabled:bg-slate-100" placeholder="0.00" ${state.sessionOpen ? 'disabled' : ''} />
                            </label>
                            <label class="text-sm font-medium text-slate-700">
                                Register location
                                <div class="mt-1 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm">
                                    ${state.locations[state.sessionLocationId] || `Location ${state.sessionLocationId}`}
                                </div>
                            </label>
                        </div>

                        <div>
                            <label class="text-sm font-medium text-slate-700">
                                Closing cash
                                <input id="closingCash" type="number" min="0" step="0.01" value="${state.closingCash}" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500 disabled:bg-slate-100" placeholder="0.00" ${state.sessionOpen ? '' : 'disabled'} />
                            </label>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <label class="text-sm font-medium text-slate-700">
                                Customer name
                                <input id="customerName" type="text" value="${state.customerName}" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500" placeholder="Walk-in Customer" />
                            </label>
                            <label class="text-sm font-medium text-slate-700">
                                Payment
                                <select id="paymentMethod" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500">
                                    <option value="cash" ${state.paymentMethod === 'cash' ? 'selected' : ''}>Cash</option>
                                    <option value="card" ${state.paymentMethod === 'card' ? 'selected' : ''}>Card</option>
                                    <option value="gcash" ${state.paymentMethod === 'gcash' ? 'selected' : ''}>GCash</option>
                                </select>
                            </label>
                            ${state.paymentMethod === 'cash' ? `
                                <label class="text-sm font-medium text-slate-700">
                                    Cash received
                                    <input id="receivedAmount" type="number" min="0" step="0.01" value="${state.receivedAmount}" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500" placeholder="0.00" />
                                    <p id="cashPreview" class="mt-2 font-semibold text-emerald-700">${cashPreview(summary.total)}</p>
                                </label>
                            ` : '<div class="rounded-xl bg-slate-50 p-3 text-xs text-slate-600">No cash amount is required. Complete the card terminal or GCash payment, then record its reference below.</div>'}
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <label class="text-sm font-medium text-slate-700">
                                Tax rate (%)
                                <input id="taxRate" type="number" min="0" max="100" step="0.01" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500" placeholder="0" value="${state.taxRate ?? ''}" />
                            </label>
                            <label class="text-sm font-medium text-slate-700">
                                Reference
                                <input id="paymentReference" type="text" value="${state.paymentReference}" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500 disabled:bg-slate-100" placeholder="${state.paymentMethod === 'card' ? 'Terminal approval code' : state.paymentMethod === 'gcash' ? 'GCash transaction reference' : 'Not required'}" ${state.paymentMethod === 'cash' ? 'disabled' : ''} />
                            </label>
                        </div>
                        ${state.paymentMethod === 'gcash' ? `
                            <div class="rounded-xl border border-blue-200 bg-blue-50 p-3 text-xs text-blue-800">
                                <p class="font-semibold">GCash QR payment</p>
                                <p class="mt-1">Enter the GCash transaction reference after the customer pays. The QR below is a payment reference prompt; configure your merchant QR payload before production.</p>
                                <img class="mx-auto mt-2 h-32 w-32 rounded-lg bg-white p-2" alt="GCash payment QR" src="https://quickchart.io/qr?text=${encodeURIComponent(`GCASH|amount=${summary.total.toFixed(2)}|reference=${document.getElementById('paymentReference')?.value || 'PENDING'}`)}&size=160" />
                            </div>
                        ` : ''}

                        <div class="grid grid-cols-2 gap-2">
                            <button id="openSessionBtn" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50" ${state.sessionOpen ? 'disabled' : ''}>Open session</button>
                            <button id="closeSessionBtn" class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-medium text-amber-700 hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50" ${state.sessionOpen ? '' : 'disabled'}>Close session</button>
                        </div>

                        <button id="checkoutBtn" class="w-full rounded-xl bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50" ${state.sessionOpen && state.cart.length ? '' : 'disabled'}>
                            ${state.sessionOpen ? 'Checkout' : 'Open a session to checkout'}
                        </button>
                    </div>
                </aside>
            </div>

            <section class="space-y-6">
                <div class="rounded-2xl bg-white p-4 shadow-lg ring-1 ring-slate-200">
                    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                        <h2 class="text-xl font-bold text-slate-900">Sales report</h2>
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                            <label class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
                                <span class="sr-only">From date</span>
                                <input id="reportFromDate" type="date" value="${state.reportRangeFrom}" class="rounded-xl border border-slate-300 px-2 py-2 text-sm text-slate-700 outline-none focus:border-sky-500" />
                            </label>
                            <label class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
                                <span class="sr-only">To date</span>
                                <input id="reportToDate" type="date" value="${state.reportRangeTo}" class="rounded-xl border border-slate-300 px-2 py-2 text-sm text-slate-700 outline-none focus:border-sky-500" />
                            </label>
                            <button id="applyReportBtn" class="rounded-xl bg-sky-600 px-3 py-2 text-sm font-semibold text-white hover:bg-sky-700">Apply</button>
                        </div>
                    </div>

                    <div class="mb-4 grid gap-3 md:grid-cols-3">
                        <div class="rounded-xl bg-slate-50 p-3">
                            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Report sales</p>
                            <p class="mt-2 text-2xl font-bold text-slate-900">${state.report.meta.total_sales ?? 0}</p>
                        </div>
                        <div class="rounded-xl bg-slate-50 p-3">
                            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Report amount</p>
                            <p class="mt-2 text-2xl font-bold text-slate-900">${formatCurrency(state.report.meta.total_amount ?? 0)}</p>
                        </div>
                        <div class="rounded-xl bg-slate-50 p-3">
                            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Payment mix</p>
                            <div class="mt-2 space-y-1 text-sm text-slate-700">
                                ${Object.keys(state.report.meta.payment_summary || {}).length ? Object.entries(state.report.meta.payment_summary).map(([method, amount]) => `
                                    <div class="flex justify-between gap-2"><span class="capitalize">${method}</span><span>${formatCurrency(amount)}</span></div>
                                `).join('') : '<p class="text-xs text-slate-500">No payment data.</p>'}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="rounded-2xl bg-white p-4 shadow-lg ring-1 ring-slate-200">
                    <div class="mb-3 flex items-center justify-between">
                        <h2 class="text-xl font-bold text-slate-900">Recent sales</h2>
                        <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">${state.sales.length} records</span>
                    </div>
                    <div class="overflow-hidden rounded-xl border border-slate-200">
                        <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                            <thead class="bg-slate-50 text-slate-600">
                                <tr>
                                    <th class="px-3 py-2 font-medium">Sale #</th>
                                    <th class="px-3 py-2 font-medium">Customer</th>
                                    <th class="px-3 py-2 font-medium">Total</th>
                                    <th class="px-3 py-2 font-medium">Status</th>
                                    <th class="px-3 py-2 font-medium">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 bg-white">
                                ${state.sales.length ? state.sales.slice(0, 6).map((sale) => `
                                    <tr>
                                        <td class="px-3 py-2 font-medium text-slate-700">${sale.sale_number || 'N/A'}</td>
                                        <td class="px-3 py-2 text-slate-600">${sale.customer?.name || 'Walk-in Customer'}</td>
                                        <td class="px-3 py-2 font-semibold text-slate-900">${formatCurrency(sale.total || 0)}</td>
                                        <td class="px-3 py-2">
                                            <span class="rounded-full px-2 py-1 text-xs font-medium ${sale.status === 'voided' ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700'}">${sale.status || 'completed'}</span>
                                        </td>
                                        <td class="px-3 py-2">
                                            <div class="flex gap-2">
                                                <button type="button" data-view-id="${sale.id}" class="view-sale-btn rounded-lg bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-200">View receipt</button>
                                                <button data-print-id="${sale.id}" class="print-sale-btn text-xs font-medium text-sky-600 hover:text-sky-700">Print</button>
                                                ${sale.status === 'completed' ? `<button data-void-id="${sale.id}" class="void-sale-btn text-xs font-medium text-red-600 hover:text-red-700">Void</button><button data-refund-id="${sale.id}" class="refund-sale-btn text-xs font-medium text-amber-600 hover:text-amber-700">Refund</button>` : ''}
                                            </div>
                                        </td>
                                    </tr>
                                `).join('') : '<tr><td colspan="5" class="px-3 py-4 text-center text-slate-500">No sales yet.</td></tr>'}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="rounded-2xl bg-white p-4 shadow-lg ring-1 ring-slate-200">
                    <div class="mb-3 flex items-center justify-between">
                        <h2 class="text-xl font-bold text-slate-900">Last receipt</h2>
                        <button id="printReceiptBtn" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50 ${receipt ? '' : 'cursor-not-allowed opacity-50'}" ${receipt ? '' : 'disabled'}>Print receipt</button>
                    </div>

                    ${receipt ? `
                        <div class="space-y-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
                            <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                                <div>
                                    <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Receipt</p>
                                    <h3 class="text-lg font-bold text-slate-900">${receipt.sale_number}</h3>
                                </div>
                                <span class="rounded-full bg-slate-900 px-2 py-1 text-xs font-medium text-white">${receipt.payment_method}</span>
                            </div>

                            <div class="space-y-2 text-sm text-slate-600">
                                <div class="flex justify-between"><span>Customer</span><span>${receipt.customer_name}</span></div>
                                <div class="flex justify-between"><span>Items</span><span>${receipt.items.length}</span></div>
                                <div class="flex justify-between"><span>Subtotal</span><span>${formatCurrency(receipt.subtotal || 0)}</span></div>
                                <div class="flex justify-between"><span>Discount</span><span>-${formatCurrency(receipt.discount_total || 0)}</span></div>
                                <div class="flex justify-between"><span>Tax</span><span>${formatCurrency(receipt.tax_total || 0)}</span></div>
                                <div class="flex justify-between border-t border-slate-200 pt-2 text-base font-bold text-slate-900"><span>Total</span><span>${formatCurrency(receipt.total || 0)}</span></div>
                                ${receipt.payment_method === 'cash' && receipt.received_amount !== null ? `
                                    <div class="flex justify-between"><span>Cash received</span><span>${formatCurrency(receipt.received_amount || 0)}</span></div>
                                    <div class="flex justify-between font-semibold text-emerald-700"><span>Change</span><span>${formatCurrency(receipt.change || 0)}</span></div>
                                ` : ''}
                            </div>
                        </div>
                    ` : '<p class="text-sm text-slate-500">No completed sale yet. The most recent receipt will appear here.</p>'}
                </div>
            </section>
        </div>
    `;

    document.getElementById('logoutButton').addEventListener('click', () => {
        state.token = '';
        state.user = null;
        state.cart = [];
        state.currentSession = null;
        state.sessionOpen = false;
        state.lastCloseSummary = null;
        state.lastReceipt = null;
        localStorage.removeItem('pos_token');
        app.innerHTML = '';
        renderLogin();
    });

    document.getElementById('productSearch').addEventListener('input', (event) => {
        state.search = event.target.value;
        clearTimeout(productSearchTimer);
        productSearchTimer = setTimeout(async () => {
            const search = state.search;
            await loadProducts(search);
            if (search !== state.search) return;

            renderDashboard();
            const searchInput = document.getElementById('productSearch');
            if (searchInput) {
                searchInput.focus();
                searchInput.setSelectionRange(search.length, search.length);
            }
        }, 250);
    });

    document.getElementById('refreshProducts').addEventListener('click', async () => {
        await loadProducts(state.search);
        renderDashboard();
    });

    document.getElementById('openSessionBtn').addEventListener('click', async () => {
        await openCashSession();
        await loadSales();
        await loadSalesSummary();
        renderDashboard();
    });

    document.getElementById('closeSessionBtn').addEventListener('click', async () => {
        await closeCashSession();
        await loadSales();
        await loadSalesSummary();
        renderDashboard();
    });

    const printReceiptBtn = document.getElementById('printReceiptBtn');
    if (printReceiptBtn && state.lastReceipt) {
        printReceiptBtn.addEventListener('click', () => {
            printReceiptFor(state.lastReceipt.id);
        });
    }

    const barcodeInput = document.getElementById('barcodeInput');
    if (barcodeInput) {
        barcodeInput.addEventListener('keydown', async (event) => {
            if (event.key !== 'Enter') return;

            const code = barcodeInput.value.trim();
            if (!code) return;

            const product = await lookupByCode(code);

            if (product) {
                addToCart(product);
                setNotice(`Added "${product.name}" to cart.`, 'success');
                barcodeInput.value = '';
                document.getElementById('barcodeInput')?.focus();
            }
        });
    }

    document.getElementById('paymentMethod').addEventListener('change', (event) => {
        state.paymentMethod = event.target.value;
        renderDashboard();
    });

    document.getElementById('customerName').addEventListener('input', (event) => {
        state.customerName = event.target.value;
    });

    document.getElementById('openingCash').addEventListener('input', (event) => {
        state.openingCash = event.target.value;
    });

    document.getElementById('closingCash').addEventListener('input', (event) => {
        state.closingCash = event.target.value;
    });

    const receivedAmountInput = document.getElementById('receivedAmount');
    if (receivedAmountInput) {
        receivedAmountInput.addEventListener('input', (event) => {
            state.receivedAmount = event.target.value;
            const preview = document.getElementById('cashPreview');
            if (preview) preview.textContent = cashPreview(getCartSummary().total);
        });
    }

    document.getElementById('paymentReference').addEventListener('input', (event) => {
        state.paymentReference = event.target.value;
    });

    document.getElementById('taxRate').addEventListener('input', (event) => {
        state.taxRate = event.target.value;
    });

    const applyReportBtn = document.getElementById('applyReportBtn');
    if (applyReportBtn) {
        applyReportBtn.addEventListener('click', async () => {
            const fromDate = document.getElementById('reportFromDate')?.value || '';
            const toDate = document.getElementById('reportToDate')?.value || '';
            state.reportRangeFrom = fromDate;
            state.reportRangeTo = toDate;
            await loadSalesReport();
            renderDashboard();
        });
    }

    const viewAllSalesToggle = document.getElementById('viewAllSalesToggle');
    if (viewAllSalesToggle) {
        viewAllSalesToggle.addEventListener('change', async (event) => {
            state.viewAllSales = event.target.checked;
            await loadSalesSummary();
            renderDashboard();
        });
    }

    document.querySelectorAll('.void-sale-btn').forEach((button) => {
        button.addEventListener('click', () => {
            voidSale(Number(button.dataset.voidId));
        });
    });

    document.querySelectorAll('.refund-sale-btn').forEach((button) => {
        button.addEventListener('click', () => {
            refundSale(Number(button.dataset.refundId));
        });
    });

    document.querySelectorAll('.view-sale-btn').forEach((button) => {
        button.addEventListener('click', () => {
            viewReceiptFor(Number(button.dataset.viewId));
        });
    });

    document.querySelectorAll('.print-sale-btn').forEach((button) => {
        button.addEventListener('click', () => {
            printReceiptFor(Number(button.dataset.printId));
        });
    });

    document.getElementById('checkoutBtn').addEventListener('click', async () => {
        if (!state.cart.length) {
            setNotice('Cart is empty.', 'error');
            return;
        }

        const receivedAmount = document.getElementById('receivedAmount')?.value || '';
        const taxRate = Number(document.getElementById('taxRate').value || 0);

        const payload = {
            payment_method: state.paymentMethod,
            received_amount: state.paymentMethod === 'cash' ? receivedAmount : null,
            payment_reference: document.getElementById('paymentReference')?.value || null,
            tax_rate: taxRate,
            customer_name: document.getElementById('customerName').value.trim() || 'Walk-in Customer',
            items: state.cart.map((item) => ({
                product_id: item.id,
                product_unit_id: item.product_unit_id,
                quantity: item.quantity,
                location_id: item.location_id,
                discount: item.discount || 0,
            })),
        };

        try {
            const response = await fetch('/api/pos/checkout', {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify(payload),
            });
            const result = await response.json();

            if (!response.ok) {
                setNotice(result.message || 'Checkout failed.', 'error');
                return;
            }

            setNotice(`Sale ${result.sale_number} completed successfully.`, 'success');
            state.cart = [];
            state.lastReceipt = {
                id: result.id,
                sale_number: result.sale_number,
                customer_name: result.customer_name || 'Walk-in Customer',
                payment_method: result.payment_method || 'cash',
                subtotal: Number(result.subtotal || 0),
                discount_total: Number(result.discount_total || 0),
                tax_total: Number(result.tax_total || 0),
                total: Number(result.total || 0),
                received_amount: state.paymentMethod === 'cash' ? Number(receivedAmount || 0) : null,
                change: state.paymentMethod === 'cash' ? Number((Number(receivedAmount || 0) - Number(result.total || 0)).toFixed(2)) : null,
                items: result.items || [],
            };
            await loadCurrentSession();
            await loadSales();
            await loadSalesSummary();
            renderDashboard();
        } catch (error) {
            setNotice('Checkout request failed.', 'error');
        }
    });

    document.querySelectorAll('.add-product-btn').forEach((button) => {
        button.addEventListener('click', () => {
            const productId = Number(button.dataset.productId);
            const product = state.products.find((item) => item.id === productId);
            if (product) addToCart(product);
        });
    });

    document.querySelectorAll('.remove-item-btn').forEach((button) => {
        button.addEventListener('click', () => {
            updateCartItem(Number(button.dataset.removeId), { quantity: 0 });
        });
    });

    document.querySelectorAll('.qty-btn').forEach((button) => {
        button.addEventListener('click', () => {
            const id = Number(button.dataset.qtyId);
            const step = Number(button.dataset.step);
            const item = state.cart.find((entry) => entry.id === id);
            if (!item) return;
            updateCartItem(id, { quantity: Math.max(0, item.quantity + step) });
        });
    });
}

if (state.token) {
    loadDashboard();
} else {
    renderLogin();
}
